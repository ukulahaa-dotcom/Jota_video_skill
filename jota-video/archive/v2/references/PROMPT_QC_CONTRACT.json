        "editor_and_generator_aspect_verified",
        "native_2d_and_private_setting_verified",
        "mode_specific_audio_direction",
        "no_duplicate_provider_job"
      ],
      "unknown_behavior": "BLOCKED_MOTION_PREGEN"
    },
    {
      "name": "P3_DIALOGUE_READY",
      "before": "VideoExpress voice/lipsync job or native dialogue audio import",
      "require": [
        "scene_id_and_speaker_turn_id",
        "character_id_and_actual_voice_id_or_supported_source",
        "literal_spoken_words_separate_from_stage_direction",
        "scene_window_and_previewed_or_bounded_duration",
        "listener_is_silent_during_other_actor_turn",
        "camera_face_or_offscreen_speech_as_mode",
        "supported_lipsync_route_when_requested",
        "rights_cleared_voice_and_optional_music",
        "no_narrator_when_dialogue_only",
        "audio_layering_plan"
      ],
      "unknown_behavior": "BLOCKED_DIALOGUE_PREGEN"
    },
    {
      "name": "P3S_SYNC_READY",
      "before": "VideoExpress JOTA2 visible-talking generation",
      "require": [
        "one_visible_speaking_actor",
        "actual_artistly_and_native_videoexpress_source_ids",
        "exact_spoken_Indonesian_line_and_timed_pause",
        "consistent_voice_emotion_brief",
        "verified_native_lipsync_audio_coupled_route",
        "talking_video_on_if_HD_route",
        "video_only_off",
        "narration_video_off",
        "private_16_9_2D",
        "quota_and_duplicate_guard"
      ],
      "unknown_behavior": "BLOCKED_LIPSYNC_NOT_VALIDATED"
    },
    {
      "name": "P4_AV_SYNC_ACCEPTED",
      "before": "Batching further JOTA2 animal speaking shots and private final release",
      "require": [
        "real_audible_and_visible_pilot_playback",
        "line_fidelity",
        "mouth_viseme_and_silence_match",
        "only_one_speaker_mouth_moving",
        "natural_voice_and_emotional_timing",
        "actual_videoexpress_native_provenance"
