      "unknown_behavior": "PILOT_QA_PENDING_NOT_ACCEPTED"
    },
    {
      "name": "C0_CONTINUOUS_TAKE_PLAN_READY",
      "before": "first VideoExpress segment of an intended >10s continuous shot",
      "require": [
        "scene_vs_shot_vs_generated_segment_separated",
        "owner_mode_and_current_media_authorization",
        "native_tool_actual_max_duration_not_only_marketing_claim",
        "one_world_and_actor_reference_lock",
        "camera_lens_axis_path_speed_and_screen_direction",
        "physical_action_velocity_and_end_pose_milestones",
        "environment_light_and_audio_continuity_plan",
        "any_visible_dialogue_has_native_synchronized_lipsync_path",
        "take_id_and_segment_manifest"
      ],
      "unknown_behavior": "BLOCKED_CONTINUOUS_TAKE_PREGEN"
    },
    {
      "name": "C1_FIRST_LAST_FRAME_PAIR_READY",
      "before": "each native VideoExpress successor segment using first/last frame",
      "require": [
        "previous_videoexpress_job_clip_identity_verified",
        "previous_segment_actual_last_frame_id_and_timestamp_verified",
        "next_segment_first_frame_is_exact_actual_previous_last_frame",
        "approved_reachable_next_last_frame",
        "same_cast_style_camera_motion_axis_light_world_props",
        "native_videoexpress_first_last_two_image_controls_verified",
        "next_target_duration_at_most_supported_tool_limit_up_to_10s",
        "no_duplicate_pending_job",
        "scene_actor_speech_not_detached_from_native_lipsync"
      ],
      "unknown_behavior": "CONTINUITY_SOURCE_OR_TOOL_UNVERIFIED"
    },
    {
      "name": "C2_CONTINUITY_SEAM_CHECK",
      "before": "claim next segment appended seamlessly",
      "require": [
        "both_native_source_clip_ids_and_real_measured_durations",
        "last_half_second_and_first_half_second_observed_in_motion",
        "no_geometry_camera_velocity_lighting_or_actor_jump",
        "no_stall_or_extra_duplicate_frame_at_join",
        "no_audio_ambience_gap_or_repeated_dialogue",
        "provider_videoexpress_native_origin"
      ],
      "unknown_behavior": "SEAM_QA_NOT_RUN"
    },
    {
      "name": "C3_CONTINUOUS_TAKE_ACCEPTED",
      "before": "claim assembled apparent uninterrupted shot passes review",
      "require": [
        "native_videoexpress_editor_take_assembled_in_sequence",
        "all_joins_pass_real_moving_visual_audio_review",
        "no_unmotivated_fades_wipes_crossdissolves_or_phony_cut_masks",
        "timeline_based_on_native_actual_duration",
        "no_actor_recast_environment_or_action_reset",
        "JOTA2_talking_actor_lipsync_P4_not_bypassed",
        "owner_review_pending_is_not_claimed_pass"
      ],
      "unknown_behavior": "TAKE_NOT_VERIFIED"
    }
  ],
  "mode_checks": {
