        "current_UI_capability_and_budget"
      ],
      "unknown_behavior": "BLOCKED_REFERENCE_OR_PERMISSION"
    },
    {
      "name": "P1_IMAGE_READY",
      "before": "Artistly image generation",
      "require": [
        "scene_id_and_revision",
        "real_approved_artistly_character_ref_ids",
        "reference_mapping_for_two_actor_scene",
        "native_aspect_16_9_or_9_16",
        "exact_visible_cast_count",
        "camera_framing_lighting_axis",
        "starting_actor_pose_for_planned_motion",
        "mode_specific_face_rules",
        "no_prompt_contradictions",
        "private_and_rights_and_credits"
      ],
      "unknown_behavior": "BLOCKED_IMAGE_PREGEN"
    },
    {
      "name": "P2_MOTION_READY",
      "before": "VideoExpress scene video generation",
      "require": [
        "approved_artistly_scene_still_id",
